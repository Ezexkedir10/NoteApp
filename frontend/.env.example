# Copy this file to ".env.local" and adjust the value.
# Never commit the real .env.local file.

# Base URL of the backend REST API (include the /api prefix, no trailing slash).
# Local:      http://localhost:5000/api
# Production: https://your-backend.example.com/api
# NOTE: Next.js bakes this value in at build time, so restart `npm run dev`
# (or rebuild) after changing it.
NEXT_PUBLIC_API_URL=http://localhost:5000/api
