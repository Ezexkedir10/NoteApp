# Copy this file to ".env" and adjust the values.
# Never commit the real .env file.

# PostgreSQL connection string.
# The default matches the docker-compose.yml in the repository root.
DATABASE_URL="postgresql://notes_user:notes_password@localhost:5432/notes_db?schema=public"

# Port the API listens on.
PORT=5000

# development | production
NODE_ENV=development

# Allowed browser origins (comma-separated, no trailing slash).
# Local frontend: http://localhost:3000
# In production, set this to your deployed frontend URL.
CORS_ORIGIN=http://localhost:3000
